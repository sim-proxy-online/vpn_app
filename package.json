{
  "name": "react-vite-tailwind",
  "private": true,
  "description": "Квадрат Петровича",
  "author": "Квадрат Петровича",
  "version": "2.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:desktop": "node tests/desktop/updateFeed.test.cjs && node tests/desktop/deviceId.test.cjs && node tests/desktop/bridge.harness.cjs",
    "test:desktop:real": "node tests/desktop/real-cores.cjs",
    "test:desktop:smoke": "node tests/desktop/smoke.cjs node_modules/electron/dist/electron.exe desktop/main.cjs",
    "test:desktop:e2e": "node tests/desktop/e2e.cjs",
    "test:watch": "vitest",
    "checksums": "node scripts/checksums.mjs",
    "theme:light": "node scripts/gen-light-theme.mjs",
    "sync-ios": "npx cap sync ios && node scripts/ios-register-plugin.mjs",
    "desktop:msix": "npm run build && npx electron-builder --win dir --x64 --config desktop/electron-builder.yml --publish never && powershell -NoProfile -ExecutionPolicy Bypass -File desktop/store/build-msix.ps1",
    "electron:build": "npm run build && npx electron-builder --win --config desktop/electron-builder.yml"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.3.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/network": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "clsx": "2.1.1",
    "electron-updater": "^6.8.3",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "main": "desktop/main.cjs",
  "devDependencies": {
    "@capacitor/cli": "^8.3.0",
    "@electron/fuses": "^2.1.2",
    "@electron/rebuild": "^3.6.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.5.0",
    "electron": "^32",
    "electron-builder": "^25.1.8",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.3.2",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.1.9"
  }
}
